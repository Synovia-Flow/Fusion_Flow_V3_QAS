# Microsoft Graph values for local/manual execution.
# Keep real values out of GitHub.
# The script accepts either GRAPH.KEY or GRAPH_KEY style names.

GRAPH.TENANT_ID=<GRAPH_TENANT_ID>
GRAPH.CLIENT_ID=<GRAPH_CLIENT_ID>
GRAPH.CLIENT_SECRET=<GRAPH_CLIENT_SECRET>
GRAPH.MAILBOX=nexus@synoviaflow.cloud
GRAPH.FOLDER=inbox
GRAPH.HISTORIC_START_DATE=2026-05-07
# Optional MVP database ingestion trace.
# Leave disabled/blank for file-only operation.
GRAPH.ENV_CODE=QAS
GRAPH.DB_ENABLED=false
GRAPH.DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=<SQL_SERVER>;Database=Fusion_Flow_V3_QAS;Trusted_Connection=yes;TrustServerCertificate=yes
# Alias accepted by FLOW V3 scripts and the Graph downloader.
DB_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=<SQL_SERVER>;Database=Fusion_Flow_V3_QAS;Trusted_Connection=yes;TrustServerCertificate=yes
# Optional scanned-PDF OCR for portal upload preview.
# Leave disabled unless Azure Document Intelligence is available.
PDF_OCR_ENABLED=false
PDF_OCR_AZURE_ENDPOINT=<AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT>
PDF_OCR_AZURE_KEY=<AZURE_DOCUMENT_INTELLIGENCE_KEY>
# PDF_OCR_AZURE_MODEL_ID=prebuilt-layout
# PDF_OCR_AZURE_API_VERSION=2024-11-30
# PDF_OCR_AZURE_FEATURES=ocrHighResolution
